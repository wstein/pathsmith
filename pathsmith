#!/usr/bin/env ruby
# pathsmith: Generate shell scripts to set PATH for various shells
# Usage: pathsmith [-v|--verbose] [-p|--paths PATHFILE] SHELL
# Outputs shell code to stdout. Source it in your shell config.

require 'optparse'
require 'etc'
require 'shellwords'

def main
  config = parse_options
  if ARGV.length != 2
    warn "[pathsmith] Usage: pathsmith <init|config> <shell> [options]"
    exit 2
  end
  subcommand = ARGV.shift
  shell_target = ARGV.shift.downcase

  case subcommand
  when 'init'
    validate_target(shell_target)
    raw_lines = read_paths_file(config[:paths_file], config[:verbose])
    all_paths = merge_with_env_path(raw_lines)
    final_paths = process_paths(all_paths, config[:verbose])
    output_result(shell_target, final_paths)
  when 'config'
    validate_target(shell_target)
    run_config(shell_target, config)
  else
    warn "[pathsmith] Unknown subcommand: #{subcommand}"
    exit 2
  end
end

def parse_options
  config = {
    paths_file: File.expand_path('~/.config/pathsmith.conf'),
    verbose: false
  }

  OptionParser.new do |opts|
    opts.banner = "Usage: pathsmith [-v|--verbose] [-p|--paths PATHFILE] SHELL"
    opts.on('-v', '--verbose', 'Enable verbose output') { config[:verbose] = true }
    opts.on('-pPATH', '--paths=PATH', 'Specify paths file') { |p| config[:paths_file] = File.expand_path(p) }
    opts.on('-h', '--help', 'Show help') do
      puts opts
      exit 0
    end
  end.parse!(ARGV)

  config
end

def validate_target(shell_target)
  supported_targets = %w[sh ash bash zsh fish nu nushell pwsh powershell list]
  unless supported_targets.include?(shell_target)
    warn "[pathsmith] Unsupported target: #{shell_target}. Supported: #{supported_targets.join(', ')}"
    exit 2
  end
end

def expand_path(str)
  # Expand environment variables, tilde, and resolve relative paths
  File.expand_path(str.gsub(/\$(\w+|\{\w+\})/) { |m| ENV[m[1..-1].gsub(/[{}]/, '')] || "" })
end

def read_paths_file(paths_file, verbose)
  File.readlines(paths_file, chomp: true) || []
rescue Errno::ENOENT
  warn "[pathsmith] Paths file not found: #{paths_file}" if verbose
  []
rescue Errno::EACCES
  warn "[pathsmith] Permission denied for paths file: #{paths_file}"
  exit 1
rescue StandardError => e
  warn "[pathsmith] Error reading paths file: #{e.message}"
  exit 1
end

def merge_with_env_path(raw_lines)
  (raw_lines + (ENV['PATH'] || '').split(File::PATH_SEPARATOR)).freeze
end

def process_paths(all_paths, verbose)
  all_paths
    .map(&:strip)
    .reject { |line| line.empty? || line.start_with?('#') }
    .map(&method(:expand_path))
    .select { |path| absolute_path?(path) }
    .select { |path| validate_directory(path, verbose) }
    .uniq
    .freeze
end

def absolute_path?(path)
  path.start_with?('/') || path =~ /^[A-Za-z]:[\/\\]/
end

def validate_directory(path, verbose)
  exists = File.directory?(path)
  if verbose
    message = exists ? "Added: #{path}" : "Skipped (not a directory): #{path}"
    warn "[pathsmith] #{message}"
  end
  exists
end

def output_result(shell_target, final_paths)
  case shell_target
  when 'list'
    final_paths.each { |p| puts p }
  when 'fish'
    puts "set -x PATH #{final_paths.map { |p| Shellwords.escape(p) }.join(' ')};"
  when 'nu', 'nushell', 'pwsh', 'powershell'
    puts "$env:PATH = \"#{final_paths.join(';')}\""
  else
    puts "export PATH=#{final_paths.map { |p| Shellwords.escape(p) }.join(File::PATH_SEPARATOR)}"
  end
end

def run_config(shell_target, config)
  unless shell_target == 'fish'
    puts "[pathsmith] config subcommand is only implemented for 'fish' right now."
    return
  end

  # Check for --apply flag
  apply = false
  if ARGV.include?('--apply')
    apply = true
    ARGV.delete('--apply')
  end

  # Determine fish_variables file location
  fish_config_dir = ENV['__fish_config_dir'] || File.expand_path('~/.config/fish')
  fish_variables_path = File.join(fish_config_dir, 'fish_variables')

  # Gather valid paths
  raw_lines = read_paths_file(config[:paths_file], config[:verbose])
  all_paths = raw_lines
    .map(&:strip)
    .reject { |line| line.empty? || line.start_with?('#') }
    .map(&method(:expand_path))
    .select { |path| absolute_path?(path) }
    .select { |path| validate_directory(path, config[:verbose]) }
    .uniq

  if all_paths.empty?
    puts '[pathsmith] No valid paths to add.'
    return
  end

  # Prepare hex-separated format
  hex_sep = '\\x1e'
  fish_list = all_paths.map { |p| p.gsub('-', '\\x2d') }.join(hex_sep)
  fish_line = "SETUVAR fish_user_paths:#{fish_list}\n"

  puts "[pathsmith] Would set fish_user_paths to (hex-sep format):"
  puts fish_line
  puts "[pathsmith] fish_variables file: #{fish_variables_path}"

  if apply
    begin
      lines = File.exist?(fish_variables_path) ? File.read(fish_variables_path).lines : []
      new_lines = []
      replaced = false
      lines.each do |line|
        # Remove any new-format or old-format fish_user_paths lines
        if line =~ /^SETUVAR\s+fish_user_paths\s+\d+\s+.*$/ || line =~ /^SETUVAR fish_user_paths:/
          unless replaced
            new_lines << fish_line
            replaced = true
          end
        else
          new_lines << line
        end
      end
      new_lines << fish_line unless replaced
      File.write(fish_variables_path, new_lines.join)
      puts "[pathsmith] Updated fish_user_paths in #{fish_variables_path} (hex-sep format)"
    rescue => e
      warn "[pathsmith] Failed to update fish_variables: #{e}"
      exit 1
    end
  else
    print "[pathsmith] Apply these changes? [y/N]: "
    answer = $stdin.gets.strip.downcase
    if answer == 'y' || answer == 'yes'
      ARGV << '--apply'
      run_config(shell_target, config)
    else
      puts "[pathsmith] No changes applied."
    end
  end
end

main if __FILE__ == $0
